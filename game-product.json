{
  "schema": "dbce.game-product",
  "schemaVersion": 1,
  "id": "fzero-snes-recomp",
  "name": "FZeroSNESRecomp",
  "versionFile": "VERSION",
  "upstream": "https://github.com/mstan/FZeroSNESRecomp",
  "fork": "https://github.com/d-b-c-e/FZeroSNESRecomp",
  "entrypoint": "FZeroSNESRecomp.exe",
  "setupArgument": "--launcher",
  "settings": ["config.ini", "fzero-video.ini", "keybinds.ini", "rom.cfg"],
  "features": {
    "wheel": {"availability": "integrated", "setup": "Mods > Controls > Racing wheel controls"},
    "ffb": {"availability": "opt-in", "setup": "Mods > Controls > Force feedback", "physicalAcceptance": "pending"},
    "telemetry": {"availability": "opt-in", "setup": "config.ini [Telemetry]", "protocol": "Forza Horizon 324-byte UDP"},
    "recordingReplay": {"availability": "experimental", "setup": "docs/PLAYTHROUGH_RECORDING.md", "physicalOutput": false, "bsDeluxeReplay": "unsupported"},
    "tripleScreen": {"availability": "experimental", "setup": "Mods > Triple-screen projection", "outputs": ["span", "separate-displays"], "limitations": ["side sprites/effects incomplete", "physical separate-display validation pending", "CRT pacing pending"]},
    "bsDeluxe": {"availability": "build-dependent", "distribution": "excluded from unified candidate", "setup": "Mods > BS Deluxe"}
  },
  "release": {"tool": "tools/package_unified.py", "channel": "candidate", "platform": "windows-x64", "distribution": "stock-only-rom-free", "preserveUserSettings": true},
  "dependencies": {"wheelToolkitPin": "lib/toolkit/VERSION", "wheelToolkitFiles": "lib/toolkit/MANIFEST.txt", "nativeRuntime": "WheelFfb.dll", "submodules": ["snesrecomp", "recomp-ui"]}
}
